{
  "name": "koreanweb-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified Full-Stack Monorepo for Korean Skincare E-commerce Store",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "node server/server.js",
    "seed": "npm run seed --workspace=server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
